{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semester-os",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // The Cloudflare Vite plugin supplies the assets directory from the build
  // output, so only the SPA fallback behaviour is configured here.
  "assets": {
    // Needed so the Worker can serve the SPA shell itself. `not_found_handling`
    // alone does nothing here: it only applies when there is no Worker script,
    // and this Worker exists, so asset misses fall through to Hono instead.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semester-os",
      // Placeholder until `wrangler d1 create semester-os` is run for deploy.
      // Local dev under `vite dev` ignores this and uses .wrangler/state.
      "database_id": "local-dev-placeholder",
      "migrations_dir": "./db/migrations"
    }
  ],

  // Nightly debt + capacity recompute (02:00 UTC), and Plan Week generation
  // on Sunday evening (18:00 UTC).
  "triggers": {
    "crons": ["0 2 * * *", "0 18 * * 0"]
  },

  "observability": {
    "enabled": true
  }
}
