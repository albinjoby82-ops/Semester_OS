{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semester-os",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // The Cloudflare Vite plugin supplies the assets directory from the build
  // output, so only the SPA fallback behaviour is configured here.
  "assets": {
    // Needed so the Worker can serve the SPA shell itself. `not_found_handling`
    // alone does nothing here: it only applies when there is no Worker script,
    // and this Worker exists, so asset misses fall through to Hono instead.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semester-os",
      // Production D1 database. Local dev under `vite dev` uses .wrangler/state.
      "database_id": "e2bf087d-4aa3-405b-a701-d228bf7b8edb",
      "migrations_dir": "./db/migrations"
    }
  ],

  // Nightly Calendar refresh (02:00 UTC), plus a Sunday evening refresh
  // before weekly planning (18:00 UTC). Cloudflare cron uses SUN or 1 for
  // Sunday; unlike traditional cron it does not accept 0.
  "triggers": {
    "crons": ["0 2 * * *", "0 18 * * SUN"]
  },

  "observability": {
    "enabled": true
  }
}
